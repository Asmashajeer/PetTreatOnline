<%- include("../../views/partials/admin/header") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css"/>
<section class="content-main container-fluid  bg-custom ">
  <div class="content-header mt-0 ">    
      <h4 class="content-title card-title ">Brands</h4>
    
  </div>
  <div class="card pb-2">
    <div class="card-header">
      <h6 class="text-center">Brands</6>
    </div>  
    <div class="card-body">
      <div class="row">
        <div class="col-md-3 shadow ">
          <form  id="newBrandForm"   method="post" action="/admin/addBrand" enctype="multipart/form-data">
            <div class="mb-4">
              <label for="name" class="form-label">Brand Name</label>
              <input   type="text" id="name"  name="name"  accept="image/png, image/jpeg, image/jpg" placeholder="Type here" class="form-control" required />
            </div>
            <label for="file" class="form-label">Brand Image</label>
            <div class="input-upload">
              <img src="" alt=""/>
              <input class="form-control border" id="file" name="file" type="file"  required/>
            </div>
            <div class="d-grid">
              <button class="btn  btn-primary mt-20" type="submit">
                Add Brand
              </button>
            </div>
          </form>
        </div>
        <div class="col-md-7 ml-105 shadow">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Brand</th>
                  <th>Logo</th>
                  <th>Status</th>
                  <th>Block/Unblock/Delete</th>
                </tr>
              </thead>
              <tbody>
               <%data.reverse().forEach((brand,index)=>{%>
                <tr>
                  <td class="text-start"><%=brand.brandName%></td>
                  <td class="text-start">
                    <div
                      class="d-flex align-items-center justify-content-center"
                      style="  width: 40px;  height: 40px;border-radius: 50%; overflow: hidden;" >
                      <img
                        src="/uploads/re-image/<%=brand.brandImage[0]%>"
                        alt="<%=brand.brandName%>"
                        class="img-fluid rounded-circle"
                        style="width: 100%; height: auto"
                      />
                    </div>
                  </td>
                 
                  <td class="text-start">
                    <%if(brand.isBlocked){%>
                      <span id="blocked_<%=brand._id%>" class="badge rounded-pill alert-danger " style="width: 60px">Blocked</span>
                      <span id="active_<%=brand._id%>" class="badge rounded-pill alert-success d-none " style="width: 60px">Active</span>
                    <%}else{%>
                      <span id="blocked_<%=brand._id%>" class="badge rounded-pill alert-danger  d-none" style="width: 60px">Blocked</span>
                      <span id="active_<%=brand._id%>" class="badge rounded-pill alert-success " style="width: 60px">Active</span>
                    <%}%>    
                  </td>
                  <td class="text-start">
                    <%if(brand.isBlocked===false){%>  
                      <button id="blockbrand_<%=brand._id%>"  onclick="blockBrand('<%=brand._id%>')" class="btn btn-sm btn-outline-danger">Block</button>    
                      <button  id="unblockbrand_<%=brand._id%>"  onclick="unblockBrand('<%=brand._id%>')" class="btn btn-sm btn-outline-success d-none">Unblock</button>                  
                                           
                    <%}else{%>  
                      <button id="blockbrand_<%=brand._id%>"  onclick="blockBrand('<%=brand._id%>')" class="btn btn-sm btn-outline-danger d-none">Block</button>    
                      <button  id="unblockbrand_<%=brand._id%>"  onclick="unblockBrand('<%=brand._id%>')" class="btn btn-sm btn-outline-success ">Unblock</button>                 
                                   
                    <%}%> 
                    <button   class="btn btn-sm "  style="width: 90px" onclick=" return confirmDelete()" >
                      <a href="/admin/deleteBrand?id=<%=brand._id%>" class="text-danger"> <i class="fas fa-trash-alt"></i></a>
                    </button>
                  </td>
                </tr>
                <%})%>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  
    <div class="pagination d-flex justify-content-center pb-2">
      <%if (currentPage>1){%>
          <a href="?page=<%= currentPage-1 %>">&laquo;</a>
      <%}%>
       <%for(let i=1;i<=totalPages;i++){%> 
          <%if(i==currentPage){%>
              <span  class="current-page bg-custom "><%= i %></span>
          <%}else{%>
              <a href="?page=<%= i %>"><%= i %></a>
      <%}}%>
      <%if (currentPage<totalPages){%>
          <a href="?page=<%= currentPage+1 %>"> &raquo; </a>
      <% }%>      
  </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>

  function confirmDelete(){
      return confirm("Are you sure ,want to delete?");
  }
  
  document.getElementById("newBrandForm").addEventListener("submit", async function (event) {
    event.preventDefault(); 
  
    const formData = new FormData(this);
    await fetch('/admin/addBrand',{
            method:'POST',            
            body: formData, 
    })
    .then((response)=>{
        console.log(response);
        if(!response.ok){
          
            return response.json().then(err=>{
                throw new Error(err.error);
            })
        }
        return response.json(); 
    })
    .then((data)=>{
        location.reload();
    })
    .catch((error)=>{
        if(error.message==='Brand already exist'){
            Swal.fire({
                icon:'error',
                title:"Oops",
                text:'Brand already exist',
                backdrop:false
            })
        }else{
            Swal.fire({
                icon:'error',
                title:'Oops',
                text:'Error occured while adding Brand',
                backdrop:false
            })
        }

    })
        
  });

  //----------------------block a brand--------------------
  function blockBrand(brandId){
    const blocked=document.getElementById(`blocked_${brandId}`);
  const active=document.getElementById(`active_${brandId}`);
    const blockbrand=document.getElementById(`blockbrand_${brandId}`);
    const unblockbrand=document.getElementById(`unblockbrand_${brandId}`);
    fetch(`/admin/blockBrand?id=${brandId}`)
    .then(response=>response.json())
    .then(data=>{
      if(data.message){
        blocked.classList.remove('d-none');
        active.classList.add('d-none');
        blockbrand.classList.add('d-none'); 
        unblockbrand.classList.remove('d-none');          
      }
    })
    .catch(error=>console.error("Error blocking brand:", error));	
}


//----------------------Unblock a brand--------------------

function unblockBrand(brandId){
  const blocked=document.getElementById(`blocked_${brandId}`);
  const active=document.getElementById(`active_${brandId}`);
    const blockbrand=document.getElementById(`blockbrand_${brandId}`);
    const unblockbrand=document.getElementById(`unblockbrand_${brandId}`);
    fetch(`/admin/unblockBrand?id=${brandId}`)
    .then(response=>response.json())
    .then(data=>{
      if(data.message){
        active.classList.remove('d-none');
        blocked.classList.add('d-none');
         unblockbrand.classList.add('d-none'); 
        blockbrand.classList.remove('d-none');          
      }
    })
    .catch(error=>console.error("Error blocking brand:", error));	
}
</script>
<%- include("../../views/partials/admin/footer") %>
