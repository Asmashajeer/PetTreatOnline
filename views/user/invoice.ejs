<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice <%= order.invoiceNo %></title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px; /* Increased font size */
            padding: 20px;
        }

        .invoice-container {
            width: 100%;
            max-width: 800px;
            margin: auto;
            border: 1px solid #ddd;
            padding: 15px; /* Reduced padding */
            background: #fff;
        }

        h2, h5 {
            text-align: center;
            font-size: 16px; /* Slightly increased heading size */
            margin-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px; /* Reduced padding */
            text-align: left;
            font-size: 14px; /* Slightly increased table text */
        }

        th {
            background-color: #f4f4f4;
        }

        .total {
            text-align: right;
            font-weight: bold;
        }

        /* Prevent page breaks inside tables */
        table, tr, td, th {
            page-break-inside: avoid;
        }

        @media print {
            .no-print {
                display: none !important; /* Hide buttons when printing */
            }
            body {
                margin: 0;
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div class="invoice-container" id="invoice-content">
        <h5>Invoice No: <small><%= order.invoiceNo %></small></h5>
        <p><strong><%= new Date(order.createdOn).toISOString().split('T')[0] %></strong></p>
        <p class="p-1"><strong>PetTreat Online Store</strong><br>Email: support@pettreat.com<br>Phone: +1 234 567 890</p>

        <h5>Billing Details</h5>
        <p>
            <strong><%= order.userId.name %></strong><br>
            <%= address.address %>, <%= address.city %><br>
            <%= address.landmark %>, <%= address.state %><br>
            <%= address.pincode %><br>
            Email: <%= order.userId.email %><br>
            Phone: <%= address.phone %>
        </p>

        <h5>Order Summary</h5>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% order.orderItems.forEach(item => { %>
                    <tr>
                        <td><%= item.productName %></td>
                        <td><%= item.quantity %></td>
                        <td><%= item.price %></td>
                        <td><%= item.subtotal %></td>
                    </tr>
                <% }); %>
                <tr>
                    <td colspan="3" class="text-right font-weight-bold">Subtotal</td>
                    <td><%= order.totalPrice %></td>
                </tr>
                <tr>
                    <td colspan="3" class="text-right font-weight-bold">Delivery</td>
                    <td><%= order.deliveryPrice %></td>
                </tr>
                <tr>
                    <td colspan="3" class="text-right font-weight-bold">Discount (Coupon)</td>
                    <td><%= order.discount %></td>
                </tr>
                <tr>
                    <td colspan="3" class="text-right font-weight-bold">Tax</td>
                    <td> - </td>
                </tr>
                <tr>
                    <td colspan="3" class="text-right font-weight-bold"><strong>Total Amount</strong></td>
                    <td><strong><%= order.orderPrice %></strong></td>
                </tr>
            </tbody>
        </table>

        <h5>Payment Details</h5>
        <p>
            <strong>Payment Method:</strong> <%= order.paymentMethod %><br>
            <strong>Payment Status:</strong> <%= order.paymentStatus %><br>
            <% if (order.paymentMethod === 'razorpay') { %>
                <strong>Receipt No:</strong> <%= order.receipt %><br>
            <% } %>
        </p>

        <p><em>Thank you for shopping with us!</em></p>
    </div>

</body>
</html>


        
        <div class="buttons no-print">
            <button class="btn btn-primary" onclick="window.print()">Print</button>
            <!-- <button class="btn btn-success" onclick="downloadInvoicePDF('<%=order.orderId%>')">Download</button> -->
            <button class="btn btn-success" onclick="downloadInvoicePDF()">Download</button>
        </div>
        <div class="buttons no-print float-right">
            <a class=" text-primary" href="/">Back to Home</a>
        </div>    
    </div>

    <!-- Bootstrap JS and dependencies (optional) -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
   
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    

<script>

        async function downloadInvoicePDF () {             
          
          
           
        const { jsPDF } = window.jspdf;
        const invoiceContent = document.getElementById("invoice-content");

        try {
            // Capture screenshot of the invoice
            const canvas = await html2canvas(invoiceContent, { scale: 2 });
            const imgData = canvas.toDataURL("image/png");

            // Create PDF
            const pdf = new jsPDF("p", "mm", "a4");
            const imgWidth = 210; // A4 width in mm
            const imgHeight = (canvas.height * imgWidth) / canvas.width; // Maintain aspect ratio

            pdf.addImage(imgData, "PNG", 0, 10, imgWidth, imgHeight);
            pdf.save(`invoice_${Date.now()}.pdf`);
        } catch (error) {
            console.error("Error generating PDF:", error);
            alert("Failed to generate PDF. Try again.");
        }
    
    }
           


</script>
</body>
</html>