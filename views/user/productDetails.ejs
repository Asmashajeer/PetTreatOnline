<%-include("../partials/user/header.ejs") -%>
>
	<!-- breadcrumb -->
	<section>
		<div class="container">
			<div class="bread-crumb flex-w p-l-25 p-r-15 p-t-60 p-lr-0-lg"style="position:relative;top:45px">
				<a href="/" class="stext-109 cl8 hov-cl1 trans-04">
					Home
					<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
				</a>

				<a href="product.html" class="stext-109 cl8 hov-cl1 trans-04">
					<%=product.category.name%>
					<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
				</a>

				<span class="stext-109 cl4">
					product Details
				</span>
			</div>
		</div>
	</section>	

	<!-- Product Detail -->
	<section class="sec-product-detail bg0 p-t-65 p-b-60">
		<div class="container">
			<div class="row">
				<div class="col-md-6 col-lg-7 p-b-30">
					<div class="p-l-25 p-r-30 p-lr-0-lg">
						<div class="wrap-slick3 flex-sb flex-w">
							<div class="wrap-slick3-dots"></div>
							<div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

							<div class="slick3 gallery-lb">
								<div class="item-slick3" data-thumb="/uploads/re-image/<%=product.productImages[0]%>">
									<div class="wrap-pic-w pos-relative">
										<img src="/uploads/re-image/<%=product.productImages[0]%>" alt="IMG-PRODUCT">

										<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="/uploads/re-image/<%=product.productImages[0]%>">
											<i class="fa fa-expand"></i>
										</a>
									</div>
								</div>

								<div class="item-slick3" style="margin:auto;" data-thumb="/uploads/re-image/<%=product.productImages[1]%>">
									<div class="wrap-pic-w pos-relative">
										<img src="/uploads/re-image/<%=product.productImages[1]%>" alt="IMG-PRODUCT">

										<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="/uploads/re-image/<%=product.productImages[1]%>">
											<i class="fa fa-expand"></i>
										</a>
									</div>
								</div>

								<div class="item-slick3" data-thumb="/uploads/re-image/<%=product.productImages[2]%>">
									<div class="wrap-pic-w pos-relative">
										<img src="/uploads/re-image/<%=product.productImages[2]%>" alt="IMG-PRODUCT">

										<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="/uploads/re-image/<%=product.productImages[2]%>">
											<i class="fa fa-expand"></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
					
				<div class="col-md-6 col-lg-5 p-b-30">
					<div class="p-r-50 p-t-5 p-lr-0-lg">						
						<h4 class="mtext-105 cl2 js-name-detail ">
							<%=product.productName%>
						</h4>
						<%if(!product.isBlocked){%>
							<div class="product-rating">
								<div class="stars ">
									<span class="star cl11">★</span> <!-- Repeat for full stars -->
									<span class="star  cl11">★</span>
									<span class="star  cl11">★</span>
									<!-- Other stars here -->
									<span class="stext-109 ">3.5/5</span>
								
								</div>
								
								
							</div>
							<span class="stext-112 cl3">
								Brand : <%=product.brand%>
							</span>
							<div class=" p-r-50 p-t-5 p-lr-0-lg">
								<%if(product.productOffer>0){%>
									<s><%=product.regularPrice.toFixed(2)%></s>
									<span class="text-danger"><b><%=product.salePrice.toFixed(2)%></b></span>											
									<span class="badge rounded-pill bg-danger  ">Offer Price</span>
								<%}else{%>
									<%=product.salePrice.toFixed(2)%>
								<%}%>		





								<!-- <p class="mtext-106 cl2">
									$<%=product.salePrice%>
								</p> -->
								<div>
									<span class="mtext-100 cl3">
									weight : <%=product.weight%>
									</span>
								</div>
								
							</div>
						
						
							<div class="p-t-10">
								<%if(product.stock>0){%>
									<span><strong><%=product.stock%></strong></span>
									<input type="hidden" id="productStock" name="productStock" value="<%=product.stock%>">
									<span class="mtext-100  cl13"><b> In-Stock</b></span>
								<%}else{%>	
									<span class="mtext-100  cl14"><b>Out Of-Stock</b></span>
								<%}%>
							<!--  -->
							<div class="p-t-33">
								<h6>Description</h6>
								<p class="stext-102 cl3 p-t-23">
									<%=product.description%>
								</p>
							</div>						
							<div class="flex-w flex-l-m p-b-10">
							
								<div class="size-204 flex-w flex-m respon6-next">
									<form id="addToCartForm">
										<input type="hidden" name="productId" id="productId" value="<%= product._id %>">
										<div class="wrap-num-product flex-l m-r-20 m-tb-10">
											<div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
												<i class="fs-16 zmdi zmdi-minus"></i>
											</div>
											<input id="numOfproduct" class="mtext-104 cl3 txt-center num-product" type="number" name="numOfproduct" value="1" min="1" max="4">

											<div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
												<i class="fs-16 zmdi zmdi-plus"></i>
											</div>
											
										</div>
										<div  id="error-message" class="alert alert-danger text-center d-none">							
										</div>
										<div class="flex-l m-r-20 m-tb-10">
											<%if(locals.user){%>
												<button type="submit" id="addToCartButton" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 js-addcart-detail" title="Add to Cart">
													Add to cart
												</button>
											<%}else{%>
												<button type="submit" id="addToCartButton" disabled class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 js-addcart-detail" title="Add to Cart" >
													Add to cart
												</button>
												<div class="ms-2 fs-14">Please <a  class ="badge badge-sm bg-warning text-dark shadow " href='/signIn'>sign in</a> to Add Cart!</div>
											<%}%>
										</div>
										
									</form>	
									
									<%if(locals.user){%>
										<div class="flex-m bor9 p-r-10 mt-5">
											<a href="#" onclick="addToWishlist('<%= product._id %>')" class="fs-26 cl1 hov-cl2 trans-04 lh-10 p-lr-5 p-tb-2 js-addwish-detail tooltip100" data-tooltip="Add to Wishlist">
												<b><i class="zmdi zmdi-favorite " id="favourite" title="Add to wishList"></i></b>
											</a>
										</div>
									<%}%>	
								</div>
							</div>
						<%}else{%>	
							<div class="text-danger">This product is unavailable</div>	
						<%}%>	
						</div>

						<!--  -->
						<div class="flex-w flex-m p-l-100 p-t-40 respon7">
							
							<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Facebook">
								<i class="fa fa-facebook"></i>
							</a>

							<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Twitter">
								<i class="fa fa-twitter"></i>
							</a>

							<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Google Plus">
								<i class="fa fa-google-plus"></i>
							</a>
						</div>
					</div>
				</div>
			</div>

			<div class="bor10 m-t-50 p-t-43 p-b-40">
				<!-- Tab01 -->
				<div class="tab01">
					<!-- Nav tabs -->
					<ul class="nav nav-tabs" role="tablist">
						<li class="nav-item p-b-10">
							<a class="nav-link active" data-toggle="tab" href="#description" role="tab">Description</a>
						</li>

						<li class="nav-item p-b-10">
							<a class="nav-link" data-toggle="tab" href="#information" role="tab">Additional information</a>
						</li>

						
					</ul>

					<!-- Tab panes -->
					<div class="tab-content p-t-43">
						<!-- - -->
						<div class="tab-pane fade show active" id="description" role="tabpanel">
							<div class="how-pos2 p-lr-15-md">
								<p class="flex-c-m cl6">
									<%=product.description%>
								</p>
							</div>
						</div>

						<!-- - -->
						<div class="tab-pane fade" id="information" role="tabpanel">
							<div class="row">
								<div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
									<ul class="p-lr-28 p-lr-15-sm">
										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												Weight
											</span>

											<span class="stext-102 cl6 size-206">
												<%=product.weight%>
											</span>
										</li>

										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												category
											</span>

											<span class="stext-102 cl6 size-206">
												<%=product.category.name%>
											</span>
										</li>

										
									</ul>
								</div>
							</div>
						</div>						
							
					</div>
				</div>
			</div>
		</div>

		<div class="bg6 flex-c-m flex-w size-302 m-t-73 p-tb-15">
			<span class="stext-107 cl6 p-lr-25">
				SKU: JAK-01
			</span>

			<span class="stext-107 cl6 p-lr-25">
				Categories: <%=product.category.name%>
			</span>
		</div>
	</section>


	

	
	<script>

		 document.addEventListener("DOMContentLoaded", function() {
		
			const form = document.getElementById('addToCartForm');
			const productStock=document.getElementById('productStock');
			const addToCartButton=document.getElementById('addToCartButton');	
			const errorMessage=document.getElementById('error-message')	;
			const productId = document.getElementById('productId').value;
			
			const numOfproduct = document.getElementById('numOfproduct');
			const quantity = parseInt(numOfproduct.value);
			numOfproduct.addEventListener('change',function(){
				console.log(quantity,productStock.value)
					if(quantity>parseInt(productStock.value)){
					errorMessage.classList.remove('d-none');
					errorMessage.classList.add('block');
				
					errorMessage.textContent=`Out of stock `;
					
					return;
					}
			});
			form.addEventListener('submit',async function(e){	
				e.preventDefault();						
				const productId = document.getElementById('productId').value;
        		const quantity = parseInt(numOfproduct.value);
			
				if (!quantity || quantity < 1) {
					errorMessage.classList.remove('d-none');
					errorMessage.classList.add('block');
					errorMessage.innerText=`select a quantity`;
					
					return;
				}
				if ( quantity > parseInt(productStock.value)) {
					errorMessage.classList.remove('d-none');
					errorMessage.classList.add('block');
					errorMessage.innerText=`Out of stock `;
					
					return;
				}
				console.log('productId  : ',productId);
				console.log('quantity:' ,quantity);
				try{
					const response=await fetch('/addToCart',{
						method:'POST',
						headers:{
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({quantity,productId})
					});	
					if (!response.ok) {
            				throw new Error(`HTTP Error! Status: ${response.status}`);
        			}		
					const data= await response.json();						
					if(data.cart){
						console.log('success', data.cart);
						window.location.href="/shopingCart";
					}else{
						console.log(data.message);
						errorMessage.classList.remove('d-none');
						errorMessage.classList.add('block');
						errorMessage.innerText=data.message;
					}
					
				}catch(error){
					console.error('Error adding to Cart:', error);
				}
			});
		});
  function addToWishlist(activeProduct){			
			const favourite=document.getElementById("favourite");
			fetch(`/addwishlist/${activeProduct}`,{method: 'GET',
						headers: {	'Content-Type': 'application/json'}, 
						})
			.then((response)=>response.json())
			.then((data)=>{		
					console.log(data.product);					
					swal(data.product, "is added to wishlist !", "success");
					favourite.style.color=green;
					favourite.disabled=true;
				
			})
			.catch((error) => {
                console.error('Error:', error);
                swal("Error", "An unexpected error occurred", error);
			});
  }
	</script>	

<%-include("../partials/user/footer.ejs") -%>